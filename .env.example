# Build-time configuration for apps/note4c. Copy to .env (git-ignored) and fill in.
WIFI_SSID=my-network
WIFI_PASSWORD=my-password
# Your frame server, see docs/FRAME_PROTOCOL.md
FRAME_URL=https://frames.example.com/frame?device=note4c&screen=main
# Optional bearer token
FRAME_KEY=
# Optional trust anchor (PEM), relative to this file. Default: ISRG Root X1 (Let's Encrypt)
# FRAME_CA_PEM=certs/my-ca.pem
